{
  "name": "@plico/site",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4210",
    "build": "pnpm registry:build && next build",
    "start": "next start --hostname 127.0.0.1 --port 4210",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:verify": "node scripts/verify-registry.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "typecheck": "tsc --noEmit",
    "verify:api": "node scripts/verify-api.mjs",
    "registry:typecheck": "node scripts/verify-registry-types.mjs",
    "verify:library": "node scripts/verify-library-api.mjs",
    "verify:consumer": "node tests/registry-consumer/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
