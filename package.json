{
  "name": "@plico/site",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4210",
    "build": "npm run registry:build && next build",
    "start": "next start --hostname 127.0.0.1 --port 4210",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:verify": "node scripts/verify-registry.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "typecheck": "tsc --noEmit",
    "verify:api": "node scripts/verify-api.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
